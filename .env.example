# 环境变量配置

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/tradingview"

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL="http://localhost:3000"
# 生成密钥: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# ============================================
# TradingView API (原有配置)
# ============================================
SESSION=your_tradingview_session_token_here
SIGNATURE=your_tradingview_signature_here
INDICATOR_ID=USER;d442347285584c9da91f3b74d7875057

# ============================================
# DingTalk (原有配置)
# ============================================
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here

# ============================================
# 可选配置
# ============================================
# Node 环境
NODE_ENV=development

# 日志级别
LOG_LEVEL=info
